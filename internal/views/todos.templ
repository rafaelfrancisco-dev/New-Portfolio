package views

import (
	"fmt"
	"strconv"

	"go-port/internal/db"
)

templ TodosPage(todos []db.Todo) {
	@Layout("Todos") {
		<main class="mx-auto max-w-xl px-4 py-12">
			<h1 class="text-2xl font-semibold tracking-tight">Todos</h1>
			<form
				hx-post="/todos"
				hx-target="#todo-list"
				hx-swap="afterbegin"
				hx-on::after-request="if (event.detail.successful) this.reset()"
				class="mt-6 flex gap-2"
			>
				<input
					type="text"
					name="title"
					required
					autocomplete="off"
					placeholder="What needs doing?"
					class="flex-1 rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-neutral-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900"
				/>
				<button
					type="submit"
					class="rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
				>
					Add
				</button>
			</form>
			@TodoList(todos)
			<div class="mt-8 flex items-center gap-3">
				<button
					hx-post="/admin/cleanup"
					hx-target="#cleanup-result"
					class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm text-neutral-600 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-400 dark:hover:bg-neutral-900"
				>
					Clean up completed
				</button>
				<span id="cleanup-result" class="text-sm text-neutral-500"></span>
			</div>
			<p class="mt-10 text-xs text-neutral-400">
				API docs at <a href="/swagger" class="underline">/swagger</a> · JSON at <a href="/api/todos" class="underline">/api/todos</a>
			</p>
		</main>
	}
}

templ TodoList(todos []db.Todo) {
	<ul id="todo-list" class="mt-6 divide-y divide-neutral-200 dark:divide-neutral-800">
		for _, t := range todos {
			@TodoRow(t)
		}
	</ul>
}

templ TodoRow(t db.Todo) {
	<li id={ todoDomID(t) } class="flex items-center gap-3 py-3">
		<button
			hx-patch={ fmt.Sprintf("/todos/%d/toggle", t.ID) }
			hx-target={ "#" + todoDomID(t) }
			hx-swap="outerHTML"
			aria-label="Toggle todo"
			class={ "flex h-5 w-5 items-center justify-center rounded border text-xs",
				templ.KV("border-neutral-900 bg-neutral-900 text-white dark:border-neutral-100 dark:bg-neutral-100 dark:text-neutral-900", t.Completed),
				templ.KV("border-neutral-300 dark:border-neutral-700", !t.Completed) }
		>
			if t.Completed {
				✓
			}
		</button>
		<span class={ "text-sm", templ.KV("text-neutral-400 line-through", t.Completed) }>{ t.Title }</span>
		<button
			hx-delete={ fmt.Sprintf("/todos/%d", t.ID) }
			hx-target={ "#" + todoDomID(t) }
			hx-swap="outerHTML"
			aria-label="Delete todo"
			class="ml-auto text-neutral-400 hover:text-red-500"
		>
			✕
		</button>
	</li>
}

templ CleanupResult(deleted int64) {
	<span>Deleted { strconv.FormatInt(deleted, 10) } completed todo(s).</span>
}

func todoDomID(t db.Todo) string {
	return fmt.Sprintf("todo-%d", t.ID)
}
