package views

import (
	"strconv"

	"go-port/internal/db"
)

templ JournalPage(posts []db.Post, filter string, years []db.CountPostsByYearRow, settings db.SiteSetting) {
	@Layout(settings, settings.DisplayName + " — Journal", "~/journal", "journal") {
		<div class="grid grid-cols-1 md:grid-cols-[1fr_300px]">
			<div class="px-6 md:px-11 py-12 md:border-r border-line flex flex-col gap-[14px]">
				@SectionLabel("03 — JOURNAL")
				<h1 class="mt-0 mb-2.5 text-[38px] font-semibold tracking-[-.01em]" style="view-transition-name: page-title">Notes from the field &amp; the desk</h1>
				<div class="flex flex-col">
					for _, p := range posts {
						<a href={ templ.SafeURL("/journal/" + p.Slug) } class="no-underline text-inherit hover:opacity-85 flex flex-col gap-2 py-6 border-t border-line">
							<span class="flex gap-[14px] font-mono text-[12.5px] text-faint">
								<span>{ formatPostDate(p) }</span>
								<span class="text-muted">{ p.Category }</span>
							</span>
							<span class="text-[21px] font-semibold leading-[1.3]" style={ vtStyle("post", p.Slug) }>{ p.Title }</span>
							<span class="text-[15px] leading-[1.6] text-muted max-w-[64ch]">{ p.Teaser }</span>
						</a>
					}
				</div>
			</div>
			<aside class="py-12 px-6 md:px-[34px] flex flex-col gap-7">
				<div class="flex flex-col gap-2.5">
					<span class="font-mono font-medium text-xs tracking-[.1em] text-faint">FILTER</span>
					<div class="flex flex-wrap gap-2 font-mono font-medium text-[12.5px]">
						@journalFilter("all", filter)
						@journalFilter("software", filter)
						@journalFilter("photography", filter)
					</div>
				</div>
				<div class="flex flex-col gap-2.5">
					<span class="font-mono font-medium text-xs tracking-[.1em] text-faint">ARCHIVE</span>
					<div class="flex flex-col gap-[7px] font-mono text-[13px] text-muted">
						for _, y := range years {
							<span>{ y.Year } — { strconv.FormatInt(y.Count, 10) } { pluralPosts(y.Count) }</span>
						}
					</div>
				</div>
				<div class="flex flex-col gap-2 border border-line rounded-md p-4">
					<span class="font-mono font-medium text-xs tracking-[.1em] text-faint">RSS</span>
					<span class="text-[13.5px] leading-[1.5] text-muted">Follow in your reader of choice.</span>
					<a href="/journal/feed.xml" class="font-mono font-semibold text-[12.5px] text-ink no-underline hover:opacity-85">/journal/feed.xml →</a>
				</div>
			</aside>
		</div>
	}
}

templ journalFilter(key string, current string) {
	<a
		href={ templ.SafeURL("/journal?filter=" + key) }
		class={ "py-1.5 px-[11px] border rounded no-underline hover:opacity-85",
			templ.KV("border-ink text-ink", key == current),
			templ.KV("border-line-strong text-muted", key != current) }
	>{ key }</a>
}

func pluralPosts(n int64) string {
	if n == 1 {
		return "post"
	}
	return "posts"
}
