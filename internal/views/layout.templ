package views

import "go-port/internal/db"

// Layout wraps every page: dark shell, terminal-style header with the current
// "path", nav with the active section highlighted, and the contact footer.
templ Layout(settings db.SiteSetting, title string, path string, active string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content={ settings.SiteDescription }/>
			<meta property="og:type" content="website"/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ settings.SiteDescription }/>
			<meta name="twitter:card" content="summary"/>
			<meta name="twitter:title" content={ title }/>
			<meta name="twitter:description" content={ settings.SiteDescription }/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<link rel="alternate" type="application/rss+xml" title={ settings.DisplayName + " — Journal" } href="/journal/feed.xml"/>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false}'/>
 <script src="/static/js/htmx.min.js" defer></script>
 <script src="/static/js/photography.js" defer></script>
		</head>
		<body class="min-h-full bg-bg text-ink font-sans antialiased flex flex-col">
			<header class="flex items-baseline justify-between gap-5 flex-wrap px-6 md:px-11 py-[26px] border-b border-line" style="view-transition-name: site-header">
				<a href="/" class="flex items-baseline gap-3 no-underline hover:opacity-85">
					<span class="font-mono font-semibold text-base">{ settings.SiteHandle }</span>
					<span class="font-mono text-[13px] text-faint">{ path }</span>
				</a>
				<nav class="flex gap-[22px] flex-wrap font-mono font-medium text-[13.5px]">
					@navLink("/software", "software", active)
					@navLink("/photography", "photography", active)
					@navLink("/journal", "journal", active)
					@navLink("/lightroom", "lightroom", active)
					@navLink("/about", "about", active)
					<a href="/journal/feed.xml" class="no-underline text-muted hover:opacity-85">rss</a>
				</nav>
			</header>
			<main class="flex-1">
				{ children... }
			</main>
			<footer class="px-6 md:px-11 py-5 border-t border-line flex justify-between gap-4 flex-wrap font-mono text-[13px] text-faint" style="view-transition-name: site-footer">
				<span>© 2026 { settings.DisplayName } · <a href={ templ.SafeURL("mailto:" + settings.ContactEmail) } class="no-underline hover:opacity-85">{ settings.ContactEmail }</a></span>
				<div class="flex gap-[18px]">
					if settings.GithubUrl != "" {
						<a href={ templ.SafeURL(settings.GithubUrl) } class="no-underline hover:opacity-85">github</a>
					}
					if settings.LinkedinUrl != "" {
						<a href={ templ.SafeURL(settings.LinkedinUrl) } class="no-underline hover:opacity-85">linkedin</a>
					}
					if settings.InstagramUrl != "" {
						<a href={ templ.SafeURL(settings.InstagramUrl) } class="no-underline hover:opacity-85">instagram</a>
					}
					<a href="/journal/feed.xml" class="no-underline hover:opacity-85">rss</a>
				</div>
			</footer>
		</body>
	</html>
}

templ navLink(href string, section string, active string) {
	<a
		href={ templ.SafeURL(href) }
		class={ "no-underline hover:opacity-85", templ.KV("text-ink", section == active), templ.KV("text-muted", section != active) }
	>{ "/" + section }</a>
}

// SectionLabel is the small tracked mono heading, e.g. "01 — SOFTWARE".
templ SectionLabel(text string) {
	<div class="font-mono font-medium text-xs tracking-[.1em] text-faint">{ text }</div>
}
