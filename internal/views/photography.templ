package views

import (
	"fmt"
	"net/url"

	"go-port/internal/db"
	"go-port/internal/flickr"
)

templ PhotographyPage(gallery flickr.Gallery, settings db.SiteSetting) {
	@Layout(settings, settings.DisplayName + " — Photography", "~/photography", "photography") {
		<div class="px-6 md:px-11 pt-12 pb-[26px] flex flex-col gap-[14px]">
			@SectionLabel("02 — PHOTOGRAPHY")
			<div class="flex justify-between items-baseline gap-5 flex-wrap">
				<h1 class="m-0 text-[38px] font-semibold tracking-[-.01em]">Photography</h1>
				if gallery.Available {
					<div class="flex gap-2 font-mono font-medium text-[12.5px] flex-wrap">
						@galleryFilter("all", "all", gallery.Filter)
						for _, album := range gallery.Albums {
							@galleryFilter(album.ID, album.Title, gallery.Filter)
						}
					</div>
				}
			</div>
			<p class="m-0 text-[15px] text-muted max-w-[62ch]">A random assortment of pictures</p>
		</div>
		if !gallery.Available {
			<div class="mx-6 md:mx-11 mb-11 border border-line rounded p-7 bg-panel">
				<h2 class="mt-0 text-xl font-semibold">Photography is temporarily unavailable</h2>
				<p class="mb-0 text-muted">The Flickr gallery has not synchronized recently enough to display. Please check back soon.</p>
			</div>
		} else if len(gallery.Photos) == 0 {
			<p class="px-6 md:px-11 pb-11 text-muted">This album has no public photos.</p>
		} else {
			<div id="masonry-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-[14px] px-6 md:px-11 pt-2 pb-11 items-start">
				for _, ph := range gallery.Photos {
					<a href={ templ.SafeURL(ph.PageURL) } style={ vtPhoto(ph) } hx-get={ photoDetailURL(ph.ID, gallery.Filter) } hx-target="#photo-modal" hx-swap="innerHTML" class="relative overflow-hidden border border-line no-underline block bg-tile hover:opacity-85">
						<img src={ templ.SafeURL(ph.SmallURL) } srcset={ ph.SmallURL + " 640w, " + ph.LargeURL + " 1600w" } sizes="(min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw" width={ fmt.Sprint(ph.Width) } height={ fmt.Sprint(ph.Height) } alt={ ph.Title } loading="lazy" class="block w-full h-auto"/>
						<span class="absolute left-0 right-0 bottom-0 py-2.5 px-3 bg-[linear-gradient(transparent,rgba(12,12,10,.72))] font-mono text-[11.5px] text-code-bright">{ ph.Title }</span>
					</a>
				}
			</div>
			<script>
				(function(){
					var grid = document.getElementById('masonry-grid');
					if (!grid) return;
					var GAP = 14, ROW = 2;
					function layout() {
						grid.style.rowGap = '0px';
						grid.style.gridAutoRows = ROW + 'px';
						var items = grid.children, heights = [], i;
						for (i = 0; i < items.length; i++) heights.push(items[i].getBoundingClientRect().height);
						for (i = 0; i < items.length; i++) items[i].style.gridRowEnd = 'span ' + Math.max(1, Math.round((heights[i] + GAP) / ROW));
					}
					var pending = false;
					function schedule() {
						if (pending) return;
						pending = true;
						requestAnimationFrame(function(){ pending = false; layout(); });
					}
					layout();
					window.addEventListener('resize', schedule);
					window.addEventListener('load', schedule);
					// Tiles resize when the viewport changes and when a lazy image
					// finally decodes at its true aspect ratio; re-measure either way.
					if (window.ResizeObserver) {
						var observer = new ResizeObserver(schedule);
						for (var n = 0; n < grid.children.length; n++) observer.observe(grid.children[n]);
					}
				})();
			</script>
		}
		<div id="photo-modal"></div>
		<script>document.addEventListener('keydown',(e)=>{if(e.key==='Escape'){const m=document.getElementById('photo-modal');if(m)m.innerHTML='';}});</script>
	}
}

templ galleryFilter(key string, label string, current string) {
	<a href={ templ.SafeURL("/photography?filter=" + url.QueryEscape(key)) } class={ "py-[7px] px-3 border rounded no-underline hover:opacity-85", templ.KV("border-ink text-ink", key == current), templ.KV("border-line-strong text-muted", key != current) }>{ label }</a>
}

templ PhotoDetail(ph flickr.Photo, prev string, next string, filter string) {
	<div onclick="document.getElementById('photo-modal').innerHTML=''" class="fixed inset-0 z-[60] bg-[rgba(9,9,8,.93)] flex items-center justify-center p-3 md:p-7">
		<div onclick="event.stopPropagation()" class="w-[min(1200px,100%)] max-h-full overflow-auto grid grid-cols-1 md:grid-cols-[1fr_340px] bg-bg border border-line rounded-lg">
			<div class="relative bg-panel min-h-[240px] flex items-center justify-center">
				<img src={ templ.SafeURL(ph.LargeURL) } width={ fmt.Sprint(ph.Width) } height={ fmt.Sprint(ph.Height) } alt={ ph.Title } class="block max-w-full max-h-[82vh] w-auto h-auto"/>
			</div>
			<aside class="pt-6 px-6 pb-[26px] flex flex-col gap-5 border-l border-line">
				<div class="flex justify-between items-baseline gap-3"><span class="font-mono font-medium text-xs tracking-[.1em] text-faint">PHOTO</span><button onclick="document.getElementById('photo-modal').innerHTML=''" class="font-mono font-semibold text-xs text-muted hover:opacity-85">✕ esc</button></div>
				<div class="flex flex-col gap-2">
					<h2 class="m-0 text-xl font-semibold leading-[1.3]">{ ph.Title }</h2>
					if ph.Description != "" {
						<p class="m-0 text-[13px] leading-[1.6] text-faint text-pretty whitespace-pre-line">{ ph.Description }</p>
					}
				</div>
				<div class="flex flex-col gap-2"><span class="font-mono font-medium text-xs tracking-[.1em] text-faint">EXIF</span><div class="flex flex-col">
					@exifRow("Camera", ph.Camera)
					@exifRow("Lens", ph.Lens)
					@exifRow("Exposure", ph.Exposure)
					@exifRow("Aperture", ph.Aperture)
					@exifRow("ISO", ph.ISO)
					@exifRow("Focal len", ph.FocalLength)
					@exifRow("Taken", ph.TakenAt)
					@exifRow("Location", ph.Location)
				</div></div>
				<a href={ templ.SafeURL(ph.PageURL) } target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-ink">View this photo on Flickr ↗</a>
				<div class="mt-auto flex justify-between gap-3 font-mono font-semibold text-xs"><a href="#" hx-get={ photoDetailURL(prev, filter) } hx-target="#photo-modal" hx-swap="innerHTML" class="text-ink no-underline hover:opacity-85">← prev</a><a href="#" hx-get={ photoDetailURL(next, filter) } hx-target="#photo-modal" hx-swap="innerHTML" class="text-ink no-underline hover:opacity-85">next →</a></div>
			</aside>
		</div>
	</div>
}

templ exifRow(key string, value string) {
	<div class="grid grid-cols-[92px_1fr] gap-3 py-2 border-t border-line-soft">
		<span class="font-mono text-[11.5px] text-faint">{ key }</span>
		<span class="font-mono text-[12.5px] text-code-bright break-words">
			if value != "" {
				{ value }
			} else {
				<span>—</span>
			}
		</span>
	</div>
}

func photoDetailURL(id string, filter string) string { return "/photography/photos/" + url.PathEscape(id) + "?filter=" + url.QueryEscape(filter) }
