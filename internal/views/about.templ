package views

import "go-port/internal/db"

templ AboutPage(settings db.SiteSetting) {
	@Layout(settings, settings.DisplayName + " — About", "~/about", "about") {
		<div class="grid grid-cols-1 md:grid-cols-[1fr_340px]">
			<div class="px-6 md:px-11 py-12 md:border-r border-line flex flex-col gap-[26px]">
				<div class="flex flex-col gap-[14px]">
					@SectionLabel("04 — ABOUT")
					<h1 class="m-0 text-[38px] font-semibold tracking-[-.01em]" style="view-transition-name: page-title">Olá, I'm Rafael.</h1>
					<p class="m-0 text-[17px] leading-[1.7] text-muted max-w-[60ch] text-pretty">I'm a software developer from Lousã, near Coimbra, Portugal. I've been building native mobile apps since 2016 — currently as Mobile Tech Lead at Eneida, where I manage the mobile portfolio for Smart Grid field tools. Evenings and weekends belong to my own apps and to a camera bag that's always slightly too heavy.</p>
				</div>
				<div class="flex flex-col gap-3">
					@SectionLabel("EXPERIENCE")
					<div class="flex flex-col">
						@experienceRow("2023 — now", "Mobile Tech Lead", "Eneida W&S — managing the mobile app portfolio, architecture and tech choices.")
						@experienceRow("2021 — 2023", "Mobile Software Engineer", "Eneida W&S — B2B iOS & Android apps for Smart Grid sensors; client analytics dashboard.")
						@experienceRow("2018 — 2020", "Software Developer", "Andi Technologies — internal tools and commercial projects across platforms.")
						@experienceRow("2016 — 2021", "iOS Developer", "YouShip — Objective-C & Swift; Apple Watch extension grown into a full app rewrite.")
					</div>
				</div>
				<div class="flex flex-col gap-3">
					@SectionLabel("LANGUAGES")
					<div class="flex gap-2.5 flex-wrap font-mono text-[12.5px] text-muted">
						<span class="border border-line-strong rounded px-[11px] py-1.5">Português — native</span>
						<span class="border border-line-strong rounded px-[11px] py-1.5">English — C1</span>
						<span class="border border-line-strong rounded px-[11px] py-1.5">Español — B1</span>
					</div>
				</div>
			</div>
			<aside class="flex flex-col">
				<div class="aspect-square bg-tile border-b border-line flex items-center justify-center">
					<span class="font-mono text-xs text-faint">[ portrait — Rafael ]</span>
				</div>
				<div class="py-[30px] px-6 md:px-[34px] flex flex-col gap-[18px]">
					@SectionLabel("CONTACT")
					<a href={ templ.SafeURL("mailto:" + settings.ContactEmail) } class="font-mono font-semibold text-sm text-ink no-underline hover:opacity-85 break-all">{ settings.ContactEmail }</a>
					<div class="flex flex-col gap-[9px] font-mono text-[13px] text-muted">
						if settings.GithubUrl != "" {
							<a href={ templ.SafeURL(settings.GithubUrl) } class="no-underline text-inherit hover:opacity-85">{ settings.GithubUrl } ↗</a>
						}
						if settings.LinkedinUrl != "" {
							<a href={ templ.SafeURL(settings.LinkedinUrl) } class="no-underline text-inherit hover:opacity-85">{ settings.LinkedinUrl } ↗</a>
						}
						if settings.InstagramUrl != "" {
							<a href={ templ.SafeURL(settings.InstagramUrl) } class="no-underline text-inherit hover:opacity-85">{ settings.InstagramUrl } ↗</a>
						}
					</div>
					<p class="m-0 text-[13.5px] leading-[1.6] text-faint">Interested in a print? Email me — most gallery photos are available in A3 and A2.</p>
				</div>
			</aside>
		</div>
	}
}

templ experienceRow(years string, role string, detail string) {
	<div class="grid grid-cols-1 md:grid-cols-[150px_1fr] gap-2 md:gap-[18px] py-[13px] border-t border-line">
		<span class="font-mono text-[12.5px] text-faint">{ years }</span>
		<span class="text-[15px] leading-[1.5]"><strong>{ role }</strong>, { detail }</span>
	</div>
}
