package views

import "go-port/internal/db"

templ AboutPage(settings db.SiteSetting) {
	@Layout(settings, aboutMeta(ctx, settings), "~/about", "about") {
		<div class="grid grid-cols-1 md:grid-cols-[1fr_340px]">
			<div class="px-6 md:px-11 py-12 md:border-r border-line flex flex-col gap-[26px]">
				<div class="flex flex-col gap-[14px]">
					@SectionLabel("05 - ABOUT")
					<h1 class="m-0 text-[38px] font-semibold tracking-[-.01em]">Olá, I'm Rafael.</h1>
					<p class="m-0 text-[17px] leading-[1.7] text-muted max-w-[60ch] text-pretty">I'm a software developer from Lousã, near Coimbra, Portugal. I've been building native mobile apps since 2016 and I'm currently Mobile Tech Lead at Eneida, where I manage the mobile apps for Smart Grid field tools. In my free time I work on my own apps and take photos, usually with a camera bag that's a little bit too heavy.</p>
				</div>
				<div class="flex flex-col gap-3">
					@SectionLabel("EXPERIENCE")
					<div class="flex flex-col">
						@experienceRow("2023 - now", "Mobile Tech Lead", "Eneida W&S - lead development of the mobile apps, including architecture and technology choices.")
						@experienceRow("2021 - 2023", "Mobile Software Engineer", "Eneida W&S - B2B iOS and Android apps for Smart Grid sensors, plus a client analytics dashboard.")
						@experienceRow("2018 - 2020", "Software Developer", "Andi Technologies - internal tools and client projects on several platforms.")
						@experienceRow("2016 - 2021", "iOS Developer", "YouShip - Objective-C and Swift, from an Apple Watch extension to a full rewrite of the app.")
					</div>
				</div>
				<div class="flex flex-col gap-3">
					@SectionLabel("LANGUAGES")
					<div class="flex gap-2.5 flex-wrap font-mono text-[12.5px] text-muted">
						<span class="border border-line-strong rounded px-[11px] py-1.5">Português - native</span>
						<span class="border border-line-strong rounded px-[11px] py-1.5">English - C2</span>
						<span class="border border-line-strong rounded px-[11px] py-1.5">Español - B1</span>
					</div>
				</div>
			</div>
			<aside id="contact" class="flex flex-col">
				<div class="py-12 px-6 md:px-[34px] flex flex-col gap-[18px]">
					@SectionLabel("CONTACT")
					<a href={ templ.SafeURL("mailto:" + settings.ContactEmail) } class="font-mono font-semibold text-sm text-ink no-underline hover:opacity-85 break-all">{ settings.ContactEmail }</a>
					<div class="flex flex-col gap-[9px] font-mono text-[13px] text-muted">
						if settings.GithubUrl != "" {
							<a href={ templ.SafeURL(settings.GithubUrl) } class="no-underline text-inherit hover:opacity-85">{ settings.GithubUrl } ↗</a>
						}
						if settings.LinkedinUrl != "" {
							<a href={ templ.SafeURL(settings.LinkedinUrl) } class="no-underline text-inherit hover:opacity-85">{ settings.LinkedinUrl } ↗</a>
						}
						if settings.InstagramUrl != "" {
							<a href={ templ.SafeURL(settings.InstagramUrl) } class="no-underline text-inherit hover:opacity-85">{ settings.InstagramUrl } ↗</a>
						}
					</div>
					<p class="m-0 text-[13.5px] leading-[1.6] text-faint">Most gallery photos are available as A3 and A2 prints. Email me if you want one.</p>
				</div>
			</aside>
		</div>
	}
}

templ experienceRow(years string, role string, detail string) {
	<div class="grid grid-cols-1 md:grid-cols-[150px_1fr] gap-2 md:gap-[18px] py-[13px] border-t border-line">
		<span class="font-mono text-[12.5px] text-faint">{ years }</span>
		<span class="text-[15px] leading-[1.5]"><strong>{ role }</strong>, { detail }</span>
	</div>
}
